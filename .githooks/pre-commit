#!/bin/sh

# 提交前阻止本地产物、敏感配置和超大新文件进入仓库。
set -eu

max_size=$((10 * 1024 * 1024))
failed=0

check_forbidden_path() {
  path=$1

  case "$path" in
    scratch/*|artifacts/*|.codex-docx-work/*|.playwright-cli/*|output/*)
      echo "禁止提交本地产物: $path" >&2
      failed=1
      ;;
    .env|.env.*|*/.env|*/.env.*)
      case "$path" in
        .env.example|*/.env.example) ;;
        *)
          echo "禁止提交环境配置: $path" >&2
          failed=1
          ;;
      esac
      ;;
    *.apk|*.aab|*.exe|*.msi|*.dmg|*.iso|*.docx|*.pdf|*.p12|*.pfx|*.pem)
      echo "禁止提交构建、文档或凭据文件: $path" >&2
      failed=1
      ;;
  esac
}

# 路径中允许有空格；仓库文件名不应包含换行符。
while IFS= read -r path; do
  [ -n "$path" ] || continue
  check_forbidden_path "$path"
done <<EOF
$(git -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR)
EOF

while IFS= read -r path; do
  [ -n "$path" ] || continue
  size=$(git cat-file -s ":$path" 2>/dev/null || echo 0)
  if [ "$size" -gt "$max_size" ]; then
    echo "禁止提交超过 10 MB 的新文件: $path ($size 字节)" >&2
    failed=1
  fi
done <<EOF
$(git -c core.quotepath=false diff --cached --name-only --diff-filter=A)
EOF

if [ "$failed" -ne 0 ]; then
  echo "请将这些文件移出仓库，或先完善忽略规则。" >&2
  exit 1
fi
