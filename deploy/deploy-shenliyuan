#!/usr/bin/env bash

# 沈理校园后端安全部署脚本。
# 支持指定目标分支或不可变 Commit SHA，不执行破坏性数据库初始化。
# 用法:
#   deploy-shenliyuan [branch_or_commit_sha]
# 示例:
#   deploy-shenliyuan 0e4ceda2
#   deploy-shenliyuan zhzh
set -Eeuo pipefail

readonly SOURCE_DIR="/opt/shenliyuan-src"
readonly RUN_DIR="/opt/shenliyuan"
readonly SERVICE_NAME="shenliyuan"
readonly DEFAULT_REF="zhzh"
readonly REQUIRED_GO_VERSION="1.25.13"
readonly TARGET_REF="${1:-${DEPLOY_REF:-$DEFAULT_REF}}"
readonly CURRENT_BINARY="${RUN_DIR}/shenliyuan"
readonly NEW_BINARY="${RUN_DIR}/shenliyuan.new"

backup_binary=""
binary_replaced=0
deploy_succeeded=0

rollback_on_failure() {
	local exit_code=$?
	if [[ "$deploy_succeeded" -eq 0 && "$binary_replaced" -eq 1 && -n "$backup_binary" && -s "$backup_binary" ]]; then
		printf '[WARN] 部署或冒烟检验失败，回滚上一版二进制: %s\n' "$backup_binary" >&2
		cp -a "$backup_binary" "${CURRENT_BINARY}.rollback"
		mv -f "${CURRENT_BINARY}.rollback" "$CURRENT_BINARY"
		chmod 0755 "$CURRENT_BINARY"
		systemctl restart "$SERVICE_NAME" || true
	fi
	rm -f -- "$NEW_BINARY" "${CURRENT_BINARY}.rollback" 2>/dev/null || true
	exit "$exit_code"
}
trap rollback_on_failure EXIT

if [[ "$EUID" -ne 0 ]]; then
	exec sudo -- "$0" "$@"
fi

if [[ ! -d "$SOURCE_DIR/.git" || ! -f "$SOURCE_DIR/server/go.mod" ]]; then
	printf '[ERR] 源码目录不完整: %s\n' "$SOURCE_DIR" >&2
	exit 1
fi

require_security_env() {
	local env_file="${RUN_DIR}/.env"
	if [[ ! -f "$env_file" ]]; then
		printf '[ERR] 缺少生产环境文件: %s\n' "$env_file" >&2
		exit 1
	fi
	for key in TRUSTED_PROXY_CIDRS SECURITY_EVENT_HMAC_SECRET SECURITY_BLOCK_ENABLED SECURITY_SOURCE_ATTRIBUTION_VALID_FROM; do
		if ! grep -Eq "^${key}=[^[:space:]]" "$env_file"; then
			printf '[ERR] 生产 .env 缺少安全变量: %s\n' "$key" >&2
			exit 1
		fi
	done
	local listen_addr
	listen_addr="$(sed -n 's/^SERVER_LISTEN_ADDR=//p' "$env_file" | tail -n 1)"
	if [[ "$listen_addr" == 0.0.0.0:* || "$listen_addr" == \:* ]]; then
		printf '[ERR] SERVER_LISTEN_ADDR 必须绑定回环地址，公网流量只能经过 Nginx: %s\n' "$listen_addr" >&2
		exit 1
	fi
}

require_security_env

if ! command -v go >/dev/null 2>&1; then
	printf '[ERR] 缺少 Go %s+，拒绝部署。\n' "$REQUIRED_GO_VERSION" >&2
	exit 1
fi
GO_VERSION="$(go version | sed -n 's/^go version go\([0-9][0-9.]*\).*/\1/p')"
if [[ -z "$GO_VERSION" || "$(printf '%s\n' "$REQUIRED_GO_VERSION" "$GO_VERSION" | sort -V | head -n 1) != "$REQUIRED_GO_VERSION" ]]; then
	printf '[ERR] Go 版本过低，需要 %s+，当前为 %s。\n' "$REQUIRED_GO_VERSION" "${GO_VERSION:-unknown}" >&2
	exit 1
fi

if [[ -n "$(git -C "$SOURCE_DIR" status --porcelain)" ]]; then
	printf '[ERR] 源码目录存在未提交改动，拒绝部署。\n' >&2
	exit 1
fi

printf '[INFO] 同步目标代码: %s\n' "$TARGET_REF"
git -C "$SOURCE_DIR" fetch origin --tags

# 判断 TARGET_REF 是否为分支，若为分支则拉取最新并 fast-forward；若为 SHA 则直接 checkout
if git -C "$SOURCE_DIR" show-ref --verify --quiet "refs/remotes/origin/${TARGET_REF}"; then
	git -C "$SOURCE_DIR" checkout "$TARGET_REF"
	git -C "$SOURCE_DIR" pull --ff-only origin "$TARGET_REF"
else
	git -C "$SOURCE_DIR" checkout "$TARGET_REF"
fi

DEPLOYED_SHA="$(git -C "$SOURCE_DIR" rev-parse HEAD)"
BUILD_TIME="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

printf '[INFO] 编译后端 ./cmd (SHA: %s, Time: %s)\n' "$DEPLOYED_SHA" "$BUILD_TIME"
cd "$SOURCE_DIR/server"
go mod download
rm -f -- "$NEW_BINARY"

go build -trimpath \
	-ldflags "-X main.GitSHA=${DEPLOYED_SHA} -X main.BuildTime=${BUILD_TIME}" \
	-o "$NEW_BINARY" ./cmd

if [[ ! -s "$NEW_BINARY" ]]; then
	printf '[ERR] 新二进制为空，拒绝替换。\n' >&2
	exit 1
fi
chmod 0755 "$NEW_BINARY"

backup_binary="${RUN_DIR}/shenliyuan.bak.$(date +%Y%m%d_%H%M%S)"
cp -a "$CURRENT_BINARY" "$backup_binary"
mv -f "$NEW_BINARY" "$CURRENT_BINARY"
binary_replaced=1

printf '[INFO] 重启服务 %s...\n' "$SERVICE_NAME"
systemctl restart "$SERVICE_NAME"
if ! systemctl is-active --quiet "$SERVICE_NAME"; then
	journalctl -u "$SERVICE_NAME" -n 30 --no-pager >&2 || true
	exit 1
fi

printf '[INFO] 执行部署后冒烟自检...\n'
# 1. 验证版本接口与能力协商标记 (硬门禁：必须 status==ok, git_sha==DEPLOYED_SHA, teacher_governance_v1==true)
version_resp=""
for i in $(seq 1 15); do
	version_resp="$(curl -sS --max-time 3 http://127.0.0.1:8080/version 2>/dev/null || true)"
	if [[ -z "$version_resp" ]]; then
		version_resp="$(curl -sS --max-time 3 http://127.0.0.1:8080/health 2>/dev/null || true)"
	fi
	if [[ -n "$version_resp" ]]; then
		break
	fi
	sleep 1
done
printf '[INFO] 版本接口响应: %s\n' "$version_resp"

python_check_cmd="
import json, sys
try:
    data = json.loads(sys.argv[1])
except Exception as e:
    print(f'[ERR] 版本接口响应非有效 JSON: {e}', file=sys.stderr)
    sys.exit(1)

status = data.get('status')
git_sha = data.get('git_sha', '')
capabilities = data.get('capabilities', {})
tg_v1 = capabilities.get('teacher_governance_v1')
expected_sha = sys.argv[2]

if status != 'ok':
    print(f'[ERR] 服务端 status != ok (实际: {status})', file=sys.stderr)
    sys.exit(1)

if git_sha != expected_sha:
    print(f'[ERR] 服务端 git_sha 不匹配! 部署目标={expected_sha}, 实际返回={git_sha}', file=sys.stderr)
    sys.exit(1)

if tg_v1 is not True:
    print(f'[ERR] 服务端能力标记 teacher_governance_v1 != true (实际: {tg_v1})', file=sys.stderr)
    sys.exit(1)

print('[OK] 版本与能力硬门禁校验通过: git_sha 匹配, teacher_governance_v1 为 true')
"

if ! python3 -c "$python_check_cmd" "$version_resp" "$DEPLOYED_SHA"; then
	printf '[ERR] 版本接口与治理能力校验未通过，触发自动回滚！\n' >&2
	exit 1
fi

# 2. 验证治理路由注册（携带非 Android 绕过头，未登录访问必须严格返回 401 或 403；其他任何状态码一律触发回滚）
governance_endpoints=(
	"/api/admin/teacher-governance/teachers"
	"/api/admin/teacher-governance/merge-records"
	"/api/admin/teacher-governance/aliases"
	"/api/admin/teacher-governance/courses"
	"/api/admin/teacher-governance/duplicate-groups"
	"/api/api/admin/teacher-governance/aliases"
	"/api/api/admin/teacher-governance/duplicate-groups"
)

for ep in "${governance_endpoints[@]}"; do
	http_code="$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 \
		-H 'X-App-Platform: deploy-smoke' \
		-H 'X-App-Channel: internal' \
		-H 'X-App-Version-Name: smoke' \
		-H 'X-App-Version-Code: 1' \
		"http://127.0.0.1:8080${ep}" || true)"
	if [[ "$http_code" != "401" && "$http_code" != "403" ]]; then
		printf '[ERR] 治理接口 %s 冒烟失败！返回 HTTP 状态码: %s (严格要求 401/403，如 404/426/500/000 均不合格)，触发自动回滚！\n' "$ep" "$http_code" >&2
		exit 1
	else
		printf '[OK] 治理接口冒烟正常: %s (HTTP %s)\n' "$ep" "$http_code"
	fi
done

deploy_succeeded=1
printf '[OK] 部署并自检完成: %s\n' "$DEPLOYED_SHA"
printf '[OK] 备份文件: %s\n' "$backup_binary"
