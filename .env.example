# Docker Compose 示例配置。复制为项目根目录 .env 后再替换为真实随机值。
DB_PASSWORD=change_me_in_env
JWT_SECRET=change_me_in_env
SUPER_ADMIN_ID=admin
SUPER_ADMIN_PASSWORD=change_me_in_env

# 可选：未设置 DSN 时 docker-compose.yml 会使用 DB_PASSWORD 生成容器内 PostgreSQL 连接串。
# DSN=host=postgres port=5432 user=postgres password=change_me_in_env dbname=shenliyuan sslmode=disable

# 账号读路径默认 legacy。只有完成 Identity 回填且脱敏对账三项均为 0 后才改为 identity。
ACCOUNT_IDENTITY_READ_MODE=legacy
# 仅填写实际反向代理容器/主机网段；留空时 Go 不信任 X-Forwarded-For。
TRUSTED_PROXY_CIDRS=

# 学校个人能力已关闭：Go/Python 不再提供服务端教务授权或个人教务路由。
# 生产部署必须保持三个开关均为 true，docker compose 缺失时拒绝启动。
SCHOOL_AUTHORITY_RETIRED=true
SCHOOL_DEVICE_CAPABILITY_CUT=true
SCHOOL_ACADEMIC_ROUTES_RETIRED=true
UPLOAD_DIR=/app/uploads
# 图片管线开关必须显式配置：GIN_MODE=release 时缺失或为空会拒绝启动。
# 生产目标值均为 true；异常时改回 false 并重启 Go（保留已生成变体）。
IMAGE_VARIANT_WORKER_ENABLED=true
# 公开上传走 Nginx internal 直传；异常时改回 false 由 Go 直接投递。
UPLOAD_USE_ACCEL_REDIRECT=true
EXAM_PAPER_DIR=/app/private/exam-papers
COMPETITION_AWARD_EVIDENCE_DIR=/app/private/competition-award-evidence
EDU_SERVICE_URL=http://python-edu-service:8000
EDU_SERVICE_TOKEN=
JWC_SYNC_ENABLED=false
JWC_SYNC_INTERVAL_MINUTES=20
INTERNAL_SERVICE_TOKEN=
EDU_CREDENTIAL_ENCRYPTION_KEY=
JWC_CRAWLER_CONTACT=

# 校园 AI 助手：启用后向所有已登录用户开放，配额与预算仍按账号控制。
AI_ENABLED=false
AI_PROVIDER=openai-compatible
# 仅由 Go 服务读取，不得写入客户端、请求体、日志或健康接口。
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-5.4
AI_REQUEST_TIMEOUT_SECONDS=60
AI_LEGACY_MAX_OUTPUT_TOKENS=4096
AI_MAX_TOOL_STEPS=3
AI_MAX_MESSAGE_CHARS=500
AI_HOURLY_MESSAGE_LIMIT=3
# 仅匹配服务端已验证学号；免除次数限制，但仍执行预算、鉴权与安全检查。
AI_UNLIMITED_STUDENT_IDS=
AI_QUOTA_EXEMPT_USER_IDS=
# 金额单位为人民币微元；价格必须按实际供应商账单定期复核。
AI_USER_BUDGET_LIMIT_MICRO_YUAN=10000000
AI_RESERVE_MICRO_YUAN=20000
AI_INPUT_PRICE_MICRO_YUAN_PER_MILLION_TOKENS=4000000
AI_OUTPUT_PRICE_MICRO_YUAN_PER_MILLION_TOKENS=16000000

# Agent v5 灰测默认关闭；恢复时必须显式配置并经过发布审批。
AI_AGENT_ENABLED=false
AI_AGENT_ROLLOUT_PERCENT=0
AI_AGENT_ROLLOUT_USER_IDS=
AI_AGENT_APP_VERSIONS=
AI_AGENT_CAPABILITIES=
AI_AGENT_MODES=
AI_AGENT_SHADOW_ENABLED=false
AI_AGENT_SHADOW_PERCENT=0
AI_AGENT_ACTIONS_ENABLED=true
AI_AGENT_PERSONAL_DATA_ENABLED=true
AI_AGENT_DEEP_MODE_ENABLED=true

# 独立 Hy3 MCP 默认关闭。Docker 仅内置 ssh_stdio；systemd 同机部署可改用 local_stdio。
AI_EXTERNAL_MCP_ENABLED=false
AI_EXTERNAL_MCP_TRANSPORT=ssh_stdio
AI_EXTERNAL_MCP_COMMAND=
AI_EXTERNAL_MCP_TOOL_TIMEOUT_SECONDS=90
AI_EXTERNAL_MCP_MAX_CALLS_PER_RUN=1
AI_EXTERNAL_MCP_SSH_HOST=
AI_EXTERNAL_MCP_SSH_PORT=22
AI_EXTERNAL_MCP_SSH_USER=mcp-runner
# 以下是宿主机文件，由 Compose 以只读 secret 挂载；启用前必须替换占位文件。
AI_EXTERNAL_MCP_SSH_KEY_FILE=./deploy/mcp/disabled-key-placeholder
AI_EXTERNAL_MCP_KNOWN_HOSTS_FILE=./deploy/mcp/disabled-known-hosts-placeholder

# P2 政策 RAG 独立开关。只有独立服务健康、迁移完成且有已发布知识时才启用。
AI_POLICY_RAG_ENABLED=false
# T09 灰度开关。必须按 internal -> 5 -> 20 -> 50 -> 100 顺序推进。
AI_LANGCHAIN_RAG_ENABLED=false
AI_LANGCHAIN_RAG_ROLLOUT_PERCENT=0
# 灰度与 100% 观察窗口都保持 true，确认窗口结束后才可单独评审关闭。
AI_LEGACY_RAG_ENABLED=true
RAG_SERVICE_URL=http://python-rag-service:8001
RAG_SERVICE_TOKEN=
RAG_OBSERVABILITY_HASH_SECRET=
RAG_EMBEDDING_MODEL_VERSION=paraphrase-multilingual-minilm-l12-v2-384-v1
RAG_DATABASE_DSN=
RAG_RETRIEVAL_CHANNEL_TIMEOUT_SECONDS=2.5
RAG_RETRIEVER_ENABLED=true
RAG_RERANKER_ENABLED=false
RAG_GENERATION_ENABLED=true
RAG_SHADOW_INDEX_ENABLED=true

# 以下 Provider 配置只注入 python-rag-service，Base URL 必须命中显式白名单。
RAG_CHAT_PROVIDER=openai-compatible
RAG_CHAT_MODEL=gpt-5.4-mini
RAG_PROVIDER_API_KEY=
RAG_PROVIDER_BASE_URL=https://api.openai.com/v1
RAG_PROVIDER_ALLOWED_BASE_URLS=https://api.openai.com/v1
RAG_PROVIDER_TIMEOUT_SECONDS=45
RAG_PROVIDER_MAX_OUTPUT_TOKENS=1600
RAG_QUERY_TIMEOUT_SECONDS=60
# 默认禁止外发 Trace；仅设置 LangSmith 自身变量不能绕过该门禁。
RAG_ALLOW_LANGSMITH=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false

# 应用内更新：APK 发布与下载
# APK 发布根目录。生产默认 /opt/shenliyuan/releases，开发默认 ./releases
APP_RELEASE_DIR=/opt/shenliyuan/releases
# 单个 APK 最大字节数（按 MB 给值），默认 200
APP_RELEASE_MAX_SIZE_MB=200
# direct_package APK 必须通过 aapt2/apksigner 的包名、版本、签名证书校验。
ANDROID_PACKAGE_NAME=com.example.shenliyuan
ANDROID_SIGNING_CERT_SHA256=
ANDROID_AAPT2_PATH=/opt/android-sdk/build-tools/35.0.0/aapt2
ANDROID_APKSIGNER_PATH=/opt/android-sdk/build-tools/35.0.0/apksigner
APP_RELEASE_MARKET_HOST_ALLOWLIST=appgallery.huawei.com
# 是否启用 426 最低版本拦截（阶段 D）；首版默认 false
APP_UPDATE_ENFORCEMENT_ENABLED=false
# 缺失 X-App-Version-* 头时是否放行业务接口；生产必须关闭
APP_UPDATE_ALLOW_MISSING_VERSION_HEADERS=false
# 生产必须使用 hard，阻止未完成协议确认的账号继续执行社区写操作。
LEGAL_CONSENT_ENFORCEMENT=hard
# 是否通过 Nginx X-Accel-Redirect 投递大文件。默认 false 直接由 Go 通过
# http.ServeContent 输出。等 Nginx 内部 location /_internal/app-releases/
# 配置完成并验证后再改为 true。
APP_RELEASE_USE_ACCEL_REDIRECT=false
APP_RELEASE_ACCEL_PREFIX=/_internal/app-releases/
