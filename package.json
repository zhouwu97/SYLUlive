{
  "name": "sylulive-web-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "pnpm --filter @sylulive/web dev",
    "dev:online": "pnpm --filter @sylulive/web dev:online",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "vitest run --config scripts/test-config/vitest.config.ts",
    "test:e2e": "playwright test --config scripts/test-config/playwright.config.ts",
    "test:e2e:local": "playwright test --config scripts/test-config/playwright.local.config.ts",
    "test:e2e:permissions": "playwright test --config scripts/test-config/playwright.permissions.config.ts",
    "assistant:dev": "pnpm --filter @sylulive/extension package:web:dev",
    "package": "pnpm build && pnpm --filter @sylulive/extension dev && node scripts/package-web.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/chrome": "^0.1.36",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
