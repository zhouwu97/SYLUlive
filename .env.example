# Docker Compose 示例配置。复制为项目根目录 .env 后再替换为真实随机值。
DB_PASSWORD=change_me_in_env
JWT_SECRET=change_me_in_env
SUPER_ADMIN_ID=admin
SUPER_ADMIN_PASSWORD=change_me_in_env

# 可选：未设置 DSN 时 docker-compose.yml 会使用 DB_PASSWORD 生成容器内 PostgreSQL 连接串。
# DSN=host=postgres port=5432 user=postgres password=change_me_in_env dbname=shenliyuan sslmode=disable

UPLOAD_DIR=/app/uploads
EXAM_PAPER_DIR=/app/private/exam-papers
EDU_SERVICE_URL=http://python-edu-service:8000
EDU_SERVICE_TOKEN=
JWC_SYNC_ENABLED=false
JWC_SYNC_INTERVAL_MINUTES=20
INTERNAL_SERVICE_TOKEN=
EDU_CREDENTIAL_ENCRYPTION_KEY=
JWC_CRAWLER_CONTACT=

# 校园 AI 助手 P0：默认关闭，内测模式必须配置用户 ID 白名单。
AI_ENABLED=false
AI_INTERNAL_TEST_ONLY=true
AI_TEST_USER_IDS=
AI_PROVIDER=deepseek
# 仅由 Go 服务读取，不得写入客户端、请求体、日志或健康接口。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash

# 应用内更新：APK 发布与下载
# APK 发布根目录。生产默认 /opt/shenliyuan/releases，开发默认 ./releases
APP_RELEASE_DIR=/opt/shenliyuan/releases
# 单个 APK 最大字节数（按 MB 给值），默认 200
APP_RELEASE_MAX_SIZE_MB=200
# 是否启用 426 最低版本拦截（阶段 D）；首版默认 false
APP_UPDATE_ENFORCEMENT_ENABLED=false
# 缺失 X-App-Version-* 头时是否放行业务接口（阶段 D）；首版默认 true 进入兼容期
APP_UPDATE_ALLOW_MISSING_VERSION_HEADERS=true
# 是否通过 Nginx X-Accel-Redirect 投递大文件。默认 false 直接由 Go 通过
# http.ServeContent 输出。等 Nginx 内部 location /_internal/app-releases/
# 配置完成并验证后再改为 true。
APP_RELEASE_USE_ACCEL_REDIRECT=false
APP_RELEASE_ACCEL_PREFIX=/_internal/app-releases/
