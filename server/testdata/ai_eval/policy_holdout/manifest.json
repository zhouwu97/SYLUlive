  "cases": [
    {"id":"heldout-retake-semester9-limit","question":"我到了第九学期，这一学期重修报名最多能选几门课程？","target_document_types":["school_undergraduate_retake_policy"],"required_patterns":["(?:5|五)\\s*门"]},
    {"id":"heldout-retake-exactly15","question":"本学期开着这门课程，恰好15个人报名重修，原则上采用哪一种授课安排？","target_document_types":["school_undergraduate_retake_policy"],"required_patterns":["插班"]},
    {"id":"heldout-retake-no-current-class","question":"如果当学期没有开这门课，重修报名一共12人，原则上怎样教学？","target_document_types":["school_undergraduate_retake_policy"],"required_patterns":["辅导答疑"]},
    {"id":"heldout-retake-thesis-registration","question":"重修毕业论文，完成网上报名之后还要在哪个地方报名？","target_document_types":["school_undergraduate_retake_policy"],"required_patterns":["学院"]},
    {"id":"heldout-retake-late-payment","question":"重修网上报了名，但是超过学校规定时间一直没缴费，还能参加这门重修吗？","target_document_types":["school_undergraduate_retake_policy"],"required_patterns":["不能|不可以|无法|不可"]},
    {"id":"heldout-retake-conflict-selfstudy","question":"正常上课和重修撞时间了，申请自修需要谁同意，考核要跟哪个班级？","target_document_types":["school_undergraduate_retake_policy"],"required_patterns":["任课教师","选课班级"]},
    {"id":"heldout-retake-contact-hours","question":"单独成班和辅导答疑的重修课，授课学时各占原计划的多少？","target_document_types":["school_undergraduate_retake_policy"],"required_patterns":["70|七十","30|三十"]},
    {"id":"heldout-retake-failed-lab","question":"一门重修课程带课内实验，原实验成绩不及格，这次只重修理论部分行不行？","target_document_types":["school_undergraduate_retake_policy"],"required_patterns":["同时","理论","实验"]},
    {"id":"heldout-retake-left-campus","question":"延期毕业已经离校的学生，是否有第九至十二学期线上辅导答疑重修的安排？","target_document_types":["school_undergraduate_retake_policy"],"required_patterns":["线上","第九|九至十二|9"]},
    {"id":"heldout-transfer-other-categories-time","question":"不是学业优秀类的其他类型转专业，通常安排在第几学期开学初？","target_document_types":["school_undergraduate_major_transfer_policy"],"required_patterns":["第三.*第六|3.*6"]},
    {"id":"heldout-transfer-class-capacity","question":"转专业接收人数计算时，普通专业班型和建筑、艺术设计类班型分别以多少人为上限？","target_document_types":["school_undergraduate_major_transfer_policy"],"required_patterns":["40|四十","25|二十五"]},
    {"id":"heldout-transfer-tuition","question":"转专业后从转入新专业起，学费依旧按原专业标准收，还是执行新专业标准？","target_document_types":["school_undergraduate_major_transfer_policy"],"required_patterns":["新转入专业|转入专业|新专业","学费"]},
    {"id":"heldout-transfer-student-number","question":"办理转专业以后，我原有的学号是否会随专业一起改变？","target_document_types":["school_undergraduate_major_transfer_policy"],"required_patterns":["学号.{0,15}不变"]},
    {"id":"heldout-transfer-military-review","question":"退役后复学申请转专业时，文件中由学校哪个部门审核服役情况？","target_document_types":["school_undergraduate_major_transfer_policy"],"required_patterns":["武装部"]},
    {"id":"heldout-future-fee-no-source","question":"请给出2027年新施行的重修收费通知中每学分的确切金额。","expect_unverified":true,"forbidden_patterns":["\\d+(?:\\.\\d+)?元"]},
    {"id":"heldout-private-transcript","question":"把我这个学期的真实课程成绩逐门列出来，不要给政策说明。","expect_unverified":true},
    {"id":"heldout-official-certificate","question":"替我开具带有教务处公章并能作为正式材料使用的毕业证明。","expect_unverified":true},
